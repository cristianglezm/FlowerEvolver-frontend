# Settings of docker-compose.yml, passed to it with --env-file docker/.env. `.devops/init.sh` copies this file to
# docker/.env and fills the empty secrets with random
# values; it never overwrites a value that is already set. .env is not committed.

# Which optional services run (comma separated):
#   monitoring   Prometheus, Grafana and the Redis and Kafka exporters
#   letsencrypt  certbot, for a real domain (without it nginx serves a self-signed certificate)
COMPOSE_PROFILES=monitoring

# podman: run the compose file together with docker-compose.podman.yml (see docker/README.md, "Podman"). Uncomment this
# line and `podman compose --env-file docker/.env up -d` does it by itself:
# COMPOSE_FILE=docker-compose.yml:docker-compose.podman.yml

# --- address ---
# The name of the site, and the address the browser uses (with the port when it is not 443). The frontend is built
# for PUBLIC_URL, so change it and run `docker compose --env-file docker/.env up -d --build`. localhost gives a self-signed certificate.
DOMAIN=localhost
PUBLIC_URL=https://localhost
# the ports published on the host. 8080 and 8443 if the ports below 1024 are not available (rootless podman), and
# then PUBLIC_URL=https://localhost:8443
HTTP_PORT=80
HTTPS_PORT=443
# Strict-Transport-Security, e.g. max-age=31536000. Leave it empty until the real certificate works: browsers
# remember it for that long.
HSTS=

# --- letsencrypt profile ---
LETSENCRYPT_EMAIL=
# --test-cert uses the staging server: it has no rate limits, but its certificates are not trusted
CERTBOT_ARGS=

# --- database ---
DB_NAME=flowerevolver
DB_USER=fe
DB_PASSWD=
DB_ROOT_PASSWD=

# --- backend ---
SECRET_KEY=
# the key of /metrics of the backend and describe; init.sh writes it to docker/secrets/metrics_api_key for Prometheus too
METRICS_API_KEY=
FLOWER_LIMIT=5000
RATE_LIMIT_TIMES=5
RATE_LIMIT_SECONDS=10
BACKEND_WORKERS=2

# --- describe ---
# Each worker loads its own models, about 800 MB of RAM. The Kafka topic gets one partition per worker.
DESCRIBE_WORKERS=1

# --- monitoring profile ---
GRAFANA_ADMIN_PASSWORD=
PROMETHEUS_RETENTION=15d

# --- images (optional) ---
# BACKEND_IMAGE=docker.io/cristianglezm/fe:backend-alpine-dev
# DESCRIBE_IMAGE=docker.io/cristianglezm/fe:describe
# CERTBOT_IMAGE=docker.io/certbot/certbot:v5.1.0
