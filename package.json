{
    "name": "flower-evolver",
    "version": "3.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "serve": "vite preview",
        "build": "vite build",
        "buildGHP": "vite build --base=/FlowerEvolver-frontend/",
        "dev": "vite",
        "lint": "eslint --fix src",
        "show": "npx playwright show-report",
        "test": "npm run test:unit && npm run test:e2e",
        "test:unit": "vitest run",
        "test:unit:watch": "vitest",
        "test:unit:ui": "vitest --ui",
        "test:e2e": "npm run build && playwright test --update-snapshots"
    },
    "dependencies": {
        "@cristianglezm/flower-evolver-wasm": "^4.1.0",
        "@floating-ui/vue": "^2.0.1",
        "@huggingface/inference": "^4.13.28",
        "@huggingface/jinja": "^0.5.1",
        "@huggingface/transformers": "^3.8.1",
        "axios": "^1.20.0",
        "dexie": "^4.4.7",
        "jszip": "^3.10.2",
        "kokoro-js": "^1.2.1",
        "mitt": "^3.0.1",
        "pinia": "^4.1.0",
        "three": "^0.186.0",
        "vue": "^3.5.44",
        "vue-axios": "^3.6.0",
        "vue-echarts": "^8.3.0",
        "vue-router": "^5.4.0",
        "waveform-data": "^4.5.2"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@pinia/testing": "^2.0.1",
        "@playwright/test": "^1.63.0",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vitest/ui": "^5.0.5",
        "@vue/test-utils": "^2.5.0",
        "eslint": "^10.13.0",
        "eslint-plugin-vue": "^10.12.0",
        "fake-indexeddb": "^6.2.5",
        "globals": "^17.13.0",
        "jsdom": "^30.0.1",
        "vite": "^8.3.5",
        "vite-plugin-eslint": "^1.8.1",
        "vite-plugin-pwa": "^2.0.0",
        "vite-plugin-vue-devtools": "^8.2.1",
        "vitest": "^5.0.0"
    },
    "allowScripts": {
        "onnxruntime-node": true,
        "protobufjs": true,
        "sharp": true
    }
}
